# ============================================================================
# AARAMBH AI - BACKEND & RUNTIME ENVIRONMENT EXAMPLE (.env.example)
# ============================================================================

# Application Runtime
NODE_ENV="development"
PORT="3000"
APP_URL="http://localhost:3000"
FRONTEND_ORIGIN="http://localhost:3000"

# Database Configuration (MongoDB Atlas or self-hosted replica set)
# When omitted in local development/preview, Aarambh AI automatically uses its
# Mongoose-validated durable local collection store (data/aarambh_db.json).
MONGODB_URI="mongodb+srv://<db_username>:<db_password>@cluster0.example.mongodb.net/aarambh_ai?retryWrites=true&w=majority"

# Authentication & Security Secrets (Must be minimum 32 bytes of entropy in production)
SESSION_SECRET="replace-with-at-least-32-byte-cryptographic-session-secret-key"
CSRF_SECRET="replace-with-at-least-32-byte-cryptographic-csrf-secret-key"

# Gemini LLM Configuration (Server-Side Only - Never prefix with VITE_)
GEMINI_API_KEY="MY_GEMINI_API_KEY"
LLM_MODEL="gemini-3.8-flash"

# Optional Email Provider Configuration (for SMTP/Transactional Verification)
EMAIL_PROVIDER="console"
EMAIL_FROM="no-reply@aarambh-events.in"
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""

# Optional Google OAuth 2.0 / OIDC Configuration
GOOGLE_CLIENT_ID=""

# Optional Object Storage Configuration (S3 / GCS for vendor quotation attachments)
STORAGE_BUCKET=""
STORAGE_REGION="ap-south-1"

# Logging & Rate Limiting
LOG_LEVEL="info"
AI_DAILY_QUOTA_PER_USER="25"

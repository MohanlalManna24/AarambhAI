# ============================================================================
# BACKEND SERVER CONFIGURATION (.env.example)
# ============================================================================
# Copy to .env in your backend runtime environment. Never commit real secrets.

NODE_ENV="development"
PORT="3000"
FRONTEND_ORIGIN="http://localhost:3000"

# MongoDB Atlas Connection String (TLS enabled, least-privilege user)
MONGODB_URI="mongodb+srv://<db_user>:<db_password>@cluster0.example.mongodb.net/aarambh_ai?retryWrites=true&w=majority&tls=true"

# Session & CSRF Secrets (Use `openssl rand -hex 32` to generate in production)
SESSION_SECRET="replace-with-minimum-32-character-random-secret"
CSRF_SECRET="replace-with-minimum-32-character-csrf-secret"

# LLM Provider Configuration (Server-Side Only)
GEMINI_API_KEY="replace-with-gemini-api-key"
LLM_MODEL="gemini-3.8-flash"
AI_DAILY_QUOTA_PER_USER="25"
AI_REQUEST_TIMEOUT_MS="45000"

# Email Verification / Password Reset Provider
EMAIL_PROVIDER="console"
EMAIL_FROM="no-reply@aarambh-events.in"

# Optional Google OAuth
GOOGLE_CLIENT_ID=""

# Optional Object Storage
STORAGE_BUCKET=""
STORAGE_REGION="ap-south-1"

# Structured Logging
LOG_LEVEL="info"

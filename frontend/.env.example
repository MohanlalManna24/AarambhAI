# ============================================================================
# FRONTEND PUBLIC CONFIGURATION (.env.example)
# ============================================================================
# WARNING: Only public variables prefixed with VITE_ belong here.
# NEVER place MONGODB_URI, GEMINI_API_KEY, SESSION_SECRET, or private OAuth
# secrets in frontend environment files.

VITE_API_BASE_URL="/api/v1"
VITE_APP_NAME="Aarambh AI"
VITE_DEFAULT_CURRENCY="INR"
VITE_DEFAULT_TIMEZONE="Asia/Kolkata"
